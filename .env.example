# Copy to .env and fill in. Never commit .env.
ASI1_API_KEY=
GITHUB_TOKEN=
# Test repo you own, where the demo issue is filed (owner/name)
DEMO_REPO=

# One distinct seed phrase per agent
CONCIERGE_SEED=
SCANNER_SEED=
ADVISORY_SEED=
FIXER_SEED=

# Filled after each agent first starts (agent1q... addresses)
SCANNER_ADDRESS=
ADVISORY_ADDRESS=
FIXER_ADDRESS=

# 1 = agents answer with canned data from agents/mocks.py
USE_MOCKS=0
